# Copy to .env and fill in. Keep .env out of git (it is .gitignored).

# --- required ---
OPENAI_API_KEY=                 # LLM for news/research agents (gpt-4o-mini)
TELEGRAM_BOT_TOKEN=             # signals bot (Bot A): customer + dev channels

# --- channels (numeric chat/channel ids) ---
# NOTE: python-dotenv treats an inline '# comment' after an EMPTY value as the
# value itself — keep comments on their own lines for empty keys.
# public signals channel (no buttons):
CUSTOMER_CHAT_ID=
# dev channel (signals + feedback buttons + brain dump):
DEV_CHAT_ID=
# alternatives also accepted: TELEGRAM_SIGNALS_CHANNEL_ID / TELEGRAM_DEV_CHANNEL_ID

# --- optional ---
# Bot B: /news /indicator /research /context /regime /derivs
TELEGRAM_CONTROL_BOT_TOKEN=
# Free key from fred.stlouisfed.org — unlocks real DXY (and official SPX):
FRED_API_KEY=

# --- trading universe (defaults: the 48 pairs in universe.py) ---
# Add/remove pairs WITHOUT code changes (full symbols, comma-separated).
# preflight.py liveness-checks every pair, so a typo or dead symbol fails loudly.
# UNIVERSE_ADD=APTUSDT,SEIUSDT
# UNIVERSE_REMOVE=GMTUSDT

# --- tuning (defaults shown) ---
LLM_MODEL=gpt-4o-mini
MAX_CONCURRENCY=5
GRADER_INTERVAL_S=60
SESSION_TTL_HOURS=12
OHLCV_TTL=300
BITREINFORCEX_DB=logs/bitreinforcex.db
RAG_EMBEDDER=auto              # auto | model2vec | minilm | hashing (auto = minilm if installed, else hashing)

# --- correctness v3 (defaults shown; wiring fixes ship ON) ---
CLOSED_CANDLES_ONLY=true       # live analysis only ever sees closed candles
NEWS_RAG_ENABLED=true          # ground news prompts in stored headlines
NWE_EVENT_MODE=true            # NWE fires on band CROSSING — backtest-validated
                               # (25-36% fewer 1h NWE emissions, precision +0.8-1.1pp,
                               #  kills duplicate sessions/RL rows; code default false)
BRAIN_DEADZONE_V2=false        # directional final needs conf >= BRAIN_MIN_CONF
BRAIN_MIN_CONF=0.25
# FRED_API_KEY=                # optional, free: fred.stlouisfed.org (SPX/DXY)

# --- agent enhancements v3 (default OFF; enable on evidence) ---
MACRO_PRICES_ENABLED=false     # real SPX/DXY 5d trends into research logics 2/5
MONEY_FLOW_V2=false            # quantitative 4-phase money-flow classifier
ECOSYSTEMS_AUTO=false          # nightly CoinGecko ecosystem membership refresh
NEWS_EVENTS_ENABLED=false      # typed event extraction (hack/etf/listing/...)
DIVERGENCE_VOTES=false         # RSI/OBV divergence type-2 votes on 4h/1d
EMPIRICAL_DIRECT_CONF=false    # nightly EB win-rate confidences for direct signals
T2_EXTRA_VOTES=                # v3.4 confluence votes csv: rsi30,mfi,cci,vwap,fib,ichimoku
T2_RULE_LEARNING=false         # v3.4 per-rule learned type-2 credibility weights

# --- accuracy upgrade rollout flags (default OFF; enable on evidence) ---
GATE_V2_ENABLED=false          # regime-gated signal gate (backtest A/B first)
GATE_1H_TREND=false            # allow trend triggers on 1h (needs 1h backtest proof)
GATE_TREND_REVERSAL=false      # amendment: flip-against-trend graded 0/6 decided
GATE_NWE_HIGHER_TF=false       # amendment: 4h ranging NWE graded 12.5% precision
TB_GRADING_ENABLED=false       # triple-barrier rewards (labels always recorded)
DERIVATIVES_ENABLED=false      # 4th voter: Binance USDM funding/OI positioning
SENTIMENT_ENABLED=false        # 5th voter: F&G + on-chain + taker flow (enable at go-live)
META_SHADOW=true               # stamp meta_p / calibrated_conf on predictions
META_GATE_ENABLED=false        # gate signals on meta_p (prod: true since v3.7 — emitted counterfactual 37.5% vs 17.8%)

# --- v3.7 learning-repair flags (prod evidence, 19-day run) ---
GATE_CONF_SATURATION=0         # >0: suppress directional emits with conf >= value (prod 0.97; conf==1.0 herd graded 1c/7w/15f)
GATE_1H_MIXED=false            # 1h mixed-regime NWE emissions (21d audit: 96 crossings @40.6% — superseded by the v3.8 ledger; only matters when EMISSION_V2_ENABLED=false)
NIGHTLY_CATCHUP=false          # run a missed 02:00 IST training once at startup (prod: true)
GATE_NWE_VOL_MAX=0             # >0: suppress NWE emits when vol_pct >= value. 19d test flat; 21d test: NWE BEST in elevated/extreme vol — keep 0

# --- v3.8 edge-first emission + Smart Money Structure (21-day audit) -------
# The hand-flag gate stack suppressed the one proven signal (NWE crossings,
# 40-50% hit outside calm vol) to ~1.5 emissions/day. The evidence ledger
# emits per measured cohort precision instead. Prod: EMISSION_V2_ENABLED=true.
EMISSION_V2_ENABLED=false      # edge-first gate (candidates -> ledger -> meta); false = v3.7.1 path
LEDGER_FLOOR=0.38              # min measured hit-rate to emit (strict posture)
LEDGER_LB_GUARD=0.30           # min Wilson lower bound (anti-fluke guard, ~random base)
LEDGER_MIN_N=25                # cohort sample floor before the test is trusted
LEDGER_PROBATION_N=40          # lifetime emit budget for brand-new sources
TRUST_DECAY=0.98               # nightly brain-trust pull toward 0 (1 = off)
SMS_ENABLED=false              # Smart Money Structure sources fire + record (prod: true)
SMS_EMIT=false                 # SMS may EMIT (backtest verdict: false — 39k events landed base+0.2-1.5pts; shadow until day-20 re-judge)
SMS_PIVOT_LEN=5
SMS_MOMENTUM_BASE=0.01
SMS_MIN_DIST=5

# --- accuracy upgrade tuning (defaults shown) ---
CONFIDENCE_GATE=0.80
VOLUME_SMA_LEN=20
REGIME_ADX_LEN=14
REGIME_CHOP_LEN=14
REGIME_VOL_LOOKBACK=100
REGIME_WALK_BARS=50
REGIME_ADX_ENTER=25.0
REGIME_ADX_EXIT=20.0
REGIME_CHOP_ENTER=38.2
REGIME_CHOP_EXIT=45.0
REGIME_MIN_DWELL=2
ATR_LEN=14
# BARRIER_MULTS as JSON: {"1h": [1.5, 1.0], "4h": [1.5, 1.0], "1d": [1.5, 1.0], "1w": [2.0, 1.25]}
REWARD_CORRECT=1.0
REWARD_WRONG=-4.0
REWARD_TIMEOUT_FLAT=-1.5
REWARD_MISSED_MOVE=-1.0
DERIV_TTL_SECONDS=3300
DERIV_FUNDING_EXTREME=0.0005
DERIV_OI_WINDOW_H=6
DERIV_BRAIN_SCORE=1.5
SENTIMENT_TTL_SECONDS=3300     # market-wide sentiment bundle cache (55 min)
SENTIMENT_BRAIN_SCORE=1.5      # brain prior for the 5th voter
META_MIN_ROWS=500
META_MODEL=logreg              # logreg | lgbm (lgbm only if installed)
META_GATE_THRESHOLD=0.55
CALIBRATION_MIN_ROWS_PER_TF=150
NIGHTLY_HOUR_IST=2
PRED_RETENTION_D=120           # nightly prune of graded predictions older than this (<=0 keeps all)
# artifact path overrides (rarely needed):
# INDICATOR_CONF_PATH=logs/indicator_conf.json
# ECOSYSTEMS_CACHE_PATH=logs/ecosystems_cache.json
# META_MODEL_PATH=logs/meta_model.pkl
# META_METRICS_PATH=logs/meta_metrics.json
# CALIBRATION_PATH=logs/calibration.json

# --- membership / subscriptions (Bot D; default OFF) -------------------------
# Rent-out mode: paid signals channel + Pro control-bot access. See
# docs/subscription-deck.html for the full design. All keys optional until
# MEMBERSHIP_ENABLED=true.
MEMBERSHIP_ENABLED=false
# Bot D token from @BotFather (the public storefront bot):
MEMBERSHIP_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to run /grant /revoke /subs:
ADMIN_USER_IDS=
MEMBERSHIP_DB=logs/subscriptions.db
PRO_DAILY_QUERY_CAP=30
MEMBERSHIP_GRACE_HOURS=24
REFERRAL_BONUS_DAYS=7
# INR rail (Razorpay Payment Links, polled — no webhook server needed):
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# USDT rail (TRC-20 amount-fingerprint matching via TronGrid):
TRON_WALLET_ADDRESS=
# optional, raises TronGrid rate limits:
TRONGRID_API_KEY=
