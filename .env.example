# Copy to .env and fill in. Keep .env out of git (it is .gitignored).

# --- required ---
OPENAI_API_KEY=                 # LLM for news/research agents (gpt-4o-mini)
TELEGRAM_BOT_TOKEN=             # signals bot (Bot A): customer + dev channels

# --- channels (numeric chat/channel ids) ---
CUSTOMER_CHAT_ID=              # public signals channel (no buttons)
DEV_CHAT_ID=                   # dev channel (signals + feedback buttons + brain dump)
# alternatives also accepted: TELEGRAM_SIGNALS_CHANNEL_ID / TELEGRAM_DEV_CHANNEL_ID

# --- optional ---
TELEGRAM_CONTROL_BOT_TOKEN=    # Bot B: /news /indicator /research /context /regime /derivs

# --- tuning (defaults shown) ---
LLM_MODEL=gpt-4o-mini
MAX_CONCURRENCY=5
GRADER_INTERVAL_S=60
SESSION_TTL_HOURS=12
OHLCV_TTL=300
BITREINFORCEX_DB=logs/bitreinforcex.db
RAG_EMBEDDER=auto              # auto | minilm | hashing

# --- correctness v3 (defaults shown; wiring fixes ship ON) ---
CLOSED_CANDLES_ONLY=true       # live analysis only ever sees closed candles
NEWS_RAG_ENABLED=true          # ground news prompts in stored headlines
NWE_EVENT_MODE=true            # NWE fires on band CROSSING — backtest-validated
                               # (25-36% fewer 1h NWE emissions, precision +0.8-1.1pp,
                               #  kills duplicate sessions/RL rows; code default false)
BRAIN_DEADZONE_V2=false        # directional final needs conf >= BRAIN_MIN_CONF
BRAIN_MIN_CONF=0.25
# FRED_API_KEY=                # optional, free: fred.stlouisfed.org (SPX/DXY)

# --- agent enhancements v3 (default OFF; enable on evidence) ---
MACRO_PRICES_ENABLED=false     # real SPX/DXY 5d trends into research logics 2/5
MONEY_FLOW_V2=false            # quantitative 4-phase money-flow classifier
ECOSYSTEMS_AUTO=false          # nightly CoinGecko ecosystem membership refresh
NEWS_EVENTS_ENABLED=false      # typed event extraction (hack/etf/listing/...)
DIVERGENCE_VOTES=false         # RSI/OBV divergence type-2 votes on 4h/1d
EMPIRICAL_DIRECT_CONF=false    # nightly EB win-rate confidences for direct signals

# --- accuracy upgrade rollout flags (default OFF; enable on evidence) ---
GATE_V2_ENABLED=false          # regime-gated signal gate (backtest A/B first)
GATE_1H_TREND=false            # allow trend triggers on 1h (needs 1h backtest proof)
TB_GRADING_ENABLED=false       # triple-barrier rewards (labels always recorded)
DERIVATIVES_ENABLED=false      # 4th voter: Binance USDM funding/OI positioning
META_SHADOW=true               # stamp meta_p / calibrated_conf on predictions
META_GATE_ENABLED=false        # gate signals on meta_p (after 4-week shadow)

# --- accuracy upgrade tuning (defaults shown) ---
CONFIDENCE_GATE=0.80
VOLUME_SMA_LEN=20
REGIME_ADX_ENTER=25.0
REGIME_ADX_EXIT=20.0
REGIME_CHOP_ENTER=38.2
REGIME_CHOP_EXIT=45.0
REGIME_MIN_DWELL=2
ATR_LEN=14
# BARRIER_MULTS as JSON: {"1h": [1.5, 1.0], "4h": [1.5, 1.0], "1d": [1.5, 1.0], "1w": [2.0, 1.25]}
REWARD_TIMEOUT_FLAT=-1.5
REWARD_MISSED_MOVE=-1.0
DERIV_TTL_SECONDS=3300
DERIV_FUNDING_EXTREME=0.0005
DERIV_BRAIN_SCORE=1.5
META_MIN_ROWS=500
META_MODEL=logreg              # logreg | lgbm (lgbm only if installed)
META_GATE_THRESHOLD=0.55
NIGHTLY_HOUR_IST=2
