# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
venv/
env/
.venv/

# VS Code settings
.vscode/
.history/

# Mac system files
.DS_Store

# Logs & temp files
*.log
*.tmp

# Runtime data — kept out of git. v3.7: learned policies + nightly artifacts
# are runtime STATE, not source (archives cover forensics); untracking them
# also kills the checkout-dance on every prod deploy. Top-level only:
# logs/backtest/**/report.json stays tracked as evidence.
logs/*.json
logs/*.json.bak-*
logs/*.pkl
logs/*.jsonl
logs/*.db
logs/*.db-wal
logs/*.db-shm
logs/archive/
logs/pre-reset-*/

# Input docs / scratch
*.docx

# Backtest: OHLCV history cache is regenerable; per-emission dumps are large.
# Reports (report.json / report.md) ARE tracked as evidence.
data/history/
logs/backtest/*/emissions.json

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Environment variables / secrets
.env
*.env
# .env backups/variants hold the SAME live secrets but match neither rule
# above (`*.env` needs the .env suffix). .env.example stays tracked.
.env.bak-*
.env.local
.env.*.bak

# Compiled libraries
*.so

# Python egg files
*.egg-info/
dist/
build/
.DS_Store

python-3.11.3/

__pycache__/
agents/__pycache__
brain/__pycache__

# backups
backups/
